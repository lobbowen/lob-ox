# ---------------------------------------------------------------------------
# lobox 单一 .gitignore（内核 core/ 与桌面壳 shell/ 合并）
# ---------------------------------------------------------------------------

# 依赖
node_modules/
**/node_modules/
.pnpm-store/

# Rust / Tauri 构建产物
target/
**/target/
shell/src-tauri/target/
shell/src-tauri/gen/

# 前端构建产物
dist/
**/dist/
core/ui/dist/
*.tsbuildinfo

# 日志与临时
*.log
logs/
tmp/
.cache/
.dsh-test-*/

# 覆盖配置
.env
.env.*
!.env.example

# 调用凭证（绝不入库；令牌泄露=账号被接管）
# 这些文件由本地工具直接读取，本地存在是必要的，但一次 git add -A 就会把它们推上远端。
# 用白名单式穷举而非 *.txt 之类的宽泛匹配，避免误伤真实源码。
.tok
.tok.txt
.token.txt
._tok
token.txt
_token.txt
_npmtoken.txt
.npmrc
*.key
*.key.pub
*.pw
*.pem
*_token*
*credential*

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# 打包与发布中间产物
*.tgz
*.zip
core/release/out/
shell/shell-release/out/
