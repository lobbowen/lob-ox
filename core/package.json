{
  "name": "lobox",
  "version": "0.0.24",
  "private": true,
  "description": "DSH 生命周期监管工具：独立于 Harness 的守卫进程，自动重启 dsh web",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobbowen/lob-ox.git"
  },
  "bin": {
    "lobox": "bin/lobox"
  },
  "scripts": {
    "build:launcher": "bash release/scripts/build-launcher.sh",
    "publish:core": "bash release/scripts/publish-core.sh"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "npmPublish": {
    "scope": "@lob-ox",
    "packages": [
      "core-linux-x64",
      "core-darwin-arm64",
      "core-darwin-x64",
      "core-win-x64"
    ]
  }
}
