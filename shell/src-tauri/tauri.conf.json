{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lobox",
  "version": "1.0.7",
  "identifier": "dev.bowen.lobox",
  "build": {
    "frontendDist": "bootstrap"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "lobox — DSH 生命周期监管",
        "width": 1280,
        "height": 800,
        "minWidth": 760,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "url": "bootstrap.html"
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri://localhost http://tauri.localhost; script-src 'self' tauri://localhost http://tauri.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' tauri://localhost http://tauri.localhost http://127.0.0.1:*; frame-src 'self' tauri://localhost http://tauri.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "dmg",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzMkFBRjAxMEZCQzFCRkIKUldUN0c3d1BBYThxODVjN2dmZWlrdVR5NWRjMTBNTWtUUUovQ0NWZzhndi9KcGdGdHNkb3poZUQK",
      "endpoints": [
        "https://unpkg.com/@lob-ox/shell-release@latest/shell-manifest.json",
        "https://cdn.jsdelivr.net/npm/@lob-ox/shell-release@latest/shell-manifest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
